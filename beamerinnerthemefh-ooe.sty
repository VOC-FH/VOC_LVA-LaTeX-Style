\ProvidesPackage{beamerinnerthemefh-ooe}
\RequirePackage{ifthen}

\useinnertheme[shadow=false]{rounded}

\defbeamertemplate*{title page}{fh-ooe}[1][]
{
  \vbox{}
  \vfill
  \begin{centering}
    \begin{beamercolorbox}[sep=8pt,center,#1]{title}
      \ifx\insertdegree\@empty%
      \else%
        {\usebeamerfont{subtitle}\usebeamercolor[fg]{subtitle}\insertdegree\par}%
        \vskip0.25em%
      \fi%
      \usebeamerfont{title}\inserttitle\par%
    \end{beamercolorbox}%
    \vskip1em\par
    \begin{beamercolorbox}[sep=8pt,center,#1]{author}
      \usebeamerfont{author}\insertauthor
    \end{beamercolorbox}
    \begin{beamercolorbox}[sep=8pt,center,#1]{institute}
      \usebeamerfont{institute}\insertinstitute
    \end{beamercolorbox}
    \begin{beamercolorbox}[sep=8pt,center,#1]{date}
      \usebeamerfont{date}\insertsemester
    \end{beamercolorbox}\vskip0.5em
    {\usebeamercolor[fg]{titlegraphic}\inserttitlegraphic\par}
  \end{centering}
  \vfill
}

\setbeamertemplate{title page}[fh-ooe][colsep=-4bp]

\defbeamertemplate*{lecture page}{fh-ooe}[1][]
{
  \begin{centering}
    \begin{beamercolorbox}[sep=8pt,center,#1]{part title}
      {\usebeamerfont{part name}\inserttitle\vskip0.5em\par\usebeamerfont{subtitle}\insertlecturepartnumbername~\insertlecturenumber}
      \vskip1em\par
      \usebeamerfont{part title}\usebeamercolor[fg]{part name}\insertlecture\par
    \end{beamercolorbox}\vskip2em
  \end{centering}
  \tableofcontents[justparts]
}

\setbeamertemplate{lecture page}[fh-ooe][colsep=-4bp]

\defbeamertemplate*{part page}{fh-ooe}[1][]
{
  \frametitle{\begin{center}\vskip-1.5em\insertpart\end{center}\vskip-2.5em}
  \framesubtitle{\begin{center}\vskip-1em\ \insertlecture\end{center}\vskip-2em}
  \tableofcontents[%
    hideallsubsections, % causes all subsections to be hidden.
    firstsection=\value{fh-ooe@firstsectioninchapter}
  ]
}

\setbeamertemplate{part page}[fh-ooe][colsep=-4bp]

\let\orig@maketitle=\maketitle%
\def\maketitle{%
  \setbeamertemplate{headline}[fh-ooe theme title page]%
  \setbeamertemplate{footline}[fh-ooe theme title page]%
%  \pdfbookmark[0]{\inserttitle}{titlepage}
  \orig@maketitle%
  \global\advance\c@framenumber by-1\relax%
}%

\def\lecturepage{\usebeamertemplate*{lecture page}}
\def\makelectureframe{
  \setbeamertemplate{headline}[fh-ooe theme lecture page]
  \setbeamertemplate{footline}[fh-ooe theme lecture page]
  \begin{frame}
    \lecturepage
  \end{frame}
}

\def\insertpartframetitle{Inhalt}
\def\makepartframe{
  \setbeamertemplate{headline}[fh-ooe theme part page]
  \setbeamertemplate{footline}[fh-ooe theme part page]
  \begin{frame}[t]
    \partpage
  \end{frame}
  \setbeamertemplate{headline}[fh-ooe theme part slide page]
  \setbeamertemplate{footline}[fh-ooe theme part slide page]
}

\def\makesectionframe{
  \setbeamertemplate{headline}[fh-ooe theme section page]
  \setbeamertemplate{footline}[fh-ooe theme section page]
  \begin{frame}[t]{\insertpart}
    \tableofcontents[%
      currentsection, % causes all sections but the current to be shown in a semi-transparent way.
%      hideallsubsections, % causes all subsections to be hidden.
      hideothersubsections,
      firstsection=\value{fh-ooe@firstsectioninchapter}
    ]
  \end{frame}
  \setbeamertemplate{headline}[fh-ooe theme section slide page]
  \setbeamertemplate{footline}[fh-ooe theme section slide page]
}

\newboolean{fh-ooe@withlecturepage}
\def\nolecturepage{\def\lecturepagedefined{defined}\setboolean{fh-ooe@withlecturepage}{false}}
\def\withlecturepage{\def\lecturepagedefined{defined}\setboolean{fh-ooe@withlecturepage}{true}}
\setboolean{fh-ooe@withlecturepage}{true}
\def\lecturepagedefined{undefined}

\AtBeginLecture{
  \ifbeamer@inlecture
    \pdfbookmark[0]{\insertlecturepartnumbername\ \insertlecturenumber\ifx\insertlecturenumbername\@empty\else: \insertlecturenumbername\fi}{Inhalt-\beamer@currentlecturelabel}
  \fi
%  \fhooe@maketitle
  \gdef\fhooe@maketitle{}
  \ifthenelse{\boolean{fh-ooe@withlecturepage}} {
    \makelectureframe
  }
}

\newboolean{fh-ooe@withpartpage}
\def\nopartpage{\def\partpagedefined{defined}\setboolean{fh-ooe@withpartpage}{false}}
\def\withpartpage{\def\partpagedefined{defined}\setboolean{fh-ooe@withpartpage}{true}}
\setboolean{fh-ooe@withpartpage}{true}
\def\partpagedefined{undefined}

\newboolean{fh-ooe@withsectionpage}
\def\nosectionpage{\def\sectionpagedefined{defined}\setboolean{fh-ooe@withsectionpage}{false}}
\def\withsectionpage{\def\sectionpagedefined{defined}\setboolean{fh-ooe@withsectionpage}{true}}
\setboolean{fh-ooe@withsectionpage}{false}
\def\sectionpagedefined{undefined}

\newcounter{fh-ooe@firstsectioninchapter}
\setcounter{fh-ooe@firstsectioninchapter}{1}

\AtBeginPart{
  \setcounter{fh-ooe@firstsectioninchapter}{\value{section}}\addtocounter{fh-ooe@firstsectioninchapter}{1}
  \ifthenelse{\boolean{fh-ooe@withpartpage}} {
    \makepartframe
  } {
    \setbeamertemplate{headline}[fh-ooe theme part slide page]
    \setbeamertemplate{footline}[fh-ooe theme part slide page]
  }
}
\AtBeginSection{%
  \ifthenelse{\boolean{fh-ooe@withsectionpage}} {%
    \makesectionframe%
  } {%
  }%
}%

\let\orig@part=\part
\renewcommand{\part}[1][]{%
  \ifthenelse{\equal{#1}{nopartpage}}{%
    \setboolean{fh-ooe@withpartpage}{false}%
  }{}%
  \ifthenelse{\equal{#1}{withpartpage}}{%
    \setboolean{fh-ooe@withpartpage}{true}%
  }{}%
  \orig@part%
}

\let\orig@section=\section
\renewcommand{\section}[1][]{%
  \ifthenelse{\equal{#1}{nosectionpage}}{%
    \setboolean{fh-ooe@withsectionpage}{false}%
  }{}%
  \ifthenelse{\equal{#1}{withsectionpage}}{%
    \setboolean{fh-ooe@withsectionpage}{true}%
  }{}%
  \orig@section%
}

\newif\ifbeamer@justparts
\beamer@justpartsfalse

\def\beamer@toc@justparts{
  \beamer@justpartstrue
  \beamer@showpartnumber=0\relax
}

\setcounter{tocdepth}{2}

\define@key{beamertoc}{justparts}[true]{\beamer@toc@justparts}

\defbeamertemplate{part in toc}{ball unnumbered}
{\leavevmode\leftskip=2.75ex%
  \llap{%
    \normalsize%
    \begin{pgfpicture}{-1ex}{-0.7ex}{1ex}{1ex}
      \pgftext{\beamer@usesphere{section number projected}{tocsphere}}
    \end{pgfpicture}%
    \kern1.25ex}%
  \inserttocpart\par
}

\defbeamertemplate{part in toc}{ball}
{\leavevmode\leftskip=2.75ex%
  \llap{%
    \normalsize%
    \begin{pgfpicture}{-1ex}{-0.7ex}{1ex}{1ex}
      \pgftext{\beamer@usesphere{section number projected}{tocsphere}}
      \pgftext{%
        \usebeamerfont*{section number projected}%
        \usebeamercolor{section number projected}%
        \color{fg!90!bg}%
        \inserttocpartnumber}
    \end{pgfpicture}%
    \kern1.25ex}%
  \inserttocpart\par
}

\setbeamertemplate{part in toc}[ball unnumbered]

\def\beamer@partintoc#1#2#3#4#5{%
  \ifbeamer@justparts{
    \ifnum\c@lecture=#4{
      \edef\inserttocpartnumber{#1}%
      \def\inserttocpart{\hyperlink{Navigation#3}{#2}}%
      \hbox{\vbox{%
              \def\beamer@breakhere{\\}
              \usebeamertemplate**{part in toc}}%
      }
      \vskip1.5em
      \par
    }\fi
  }\fi
}

\patchcmd{\beamer@part}%
  {\def\beamer@partnameshort{#1}}%
  {%
    \def\beamer@partnameshort{#1}%
    \beamer@savemode%
    \mode<presentation>%
    \addtocontents{toc}{\protect\beamer@partintoc{\the\c@part}{#2}{\the\c@page}{\the\c@lecture}{0}}%
    \beamer@resumemode%
  }%
  {}{\errmessage{failed to patch beamer@part}}
  
\apptocmd{\beamer@part}{%
  \beamer@savemode%
  \mode<presentation>%
  \ifbeamer@inlecture%
  \else%
    \beamer@atbeginpart%
  \fi%
  \beamer@resumemode%
}%
{}{\errmessage{failed to apptocmd beamer@part}}%

\apptocmd{\beamer@section}{%
  \beamer@savemode%
  \mode<presentation>%
  \ifbeamer@inlecture%
  \else%
    \beamer@ifempty{#2}{\beamer@atbeginsections}{\beamer@atbeginsection}%
  \fi%
  \beamer@resumemode%
}%
{}{\errmessage{failed to apptocmd beamer@section}}%

\apptocmd{\beamer@subsection}{%
  \beamer@savemode%
  \mode<presentation>%
  \ifbeamer@inlecture%
  \else%
    \beamer@ifempty{#2}{\beamer@atbeginsubsections}{\beamer@atbeginsubsection}%
  \fi%
  \beamer@resumemode%
}%
{}{\errmessage{failed to apptocmd beamer@subsection}}%

\apptocmd{\beamer@subsubsection}{%
  \beamer@savemode%
  \mode<presentation>%
  \ifbeamer@inlecture%
  \else%
    \beamer@ifempty{#2}{\beamer@atbeginsubsubsections}{\beamer@atbeginsubsubsection}%
  \fi%
  \beamer@resumemode%
}%
{}{\errmessage{failed to apptocmd beamer@subsubsection}}%
