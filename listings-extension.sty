\ProvidesPackage{listings-extension}
\RequirePackage{listings}
\RequirePackage{etoolbox}

\def\codelistingname{Listing}
\def\lstlistingname{\codelistingname}


\newcommand{\writesourcestofile}[1]{%
  \def\@writesourcefile{\write#1}
}

\def\@writesourcefile[1]{%
  \relax
}

\newcommand{\addsourcefile}[1]{%
  \@writesourcefile{#1}%
}%

\newcommand\inlinecppcode[1][]{\lstinline[style=eclipse-inline,language=c++,#1]}

\lstnewenvironment{cppcode}[1][]{
  \lstset{style=eclipse,language=c++,#1}%
  \lstset{xleftmargin=\lst@numbersep}%
}{}

\newcommand{\@cppcoderangerelay}[3][]{%
  \edef\@eargs{[linerange=#2-#2,firstnumber=#2,\@begarg,#1]{#3}}
  \def\@endcmd{\expandafter\includecppcode\@eargs}
  \newcommand\range[3][]{%
    \edef\@rargs{[linerange=##2-##3,firstnumber=##2,#1,caption=,\@begarg,##1]{#3}}
    \expandafter\includecppcode\@rargs
  }
  \edef\@sargs{[linerange=1-1,caption=,\@begarg]{#3}}
  \expandafter\includecppcode\@sargs%
}

\newenvironment{cppcoderange}[1][]{%
  \def\@begarg{#1}%
  \@cppcoderangerelay%
}{
  \@endcmd%
  \ignorespacesafterend%
}%

\newcommand{\addcppfile}[2]{
  \addsourcefile{\@cppsourcepath/#1/#2}%
}

\newcommand{\includecppcode}[3][]{%
  \addsourcefile{\@cppsourcepath/#2/#3}%
  \href{run:\@cppsourcepath/#2/#3}{%
    \vbox{
      \lstinputlisting[%
        language=c++,%
        style=eclipse,%
        xleftmargin=\lst@numbersep,%
        resetmargins=true,%
        caption=\codefontfamily #3,%
        #1%
      ]{%
        \@cppsourcepath/#2/#3%
      }%
    }%
  }%
}

\lstnewenvironment{cppapi}[1][]{
  \lstset{%
    style=eclipse,
    language=c++,
    basicstyle=\normalsize\codefontfamily,
    resetmargins=true,
    xleftmargin=\lst@numbersep,
    numbers=none,
    #1
  }%
}{}

\newcommand\inlinejavacode[1][]{\lstinline[style=eclipse-inline,language=java,#1]}

\newcommand{\setjavasourcepath}[1]{%
  \def\@javasourcepath{#1}%
}

\lstnewenvironment{javacode}[1][]{
  \codefontsize
  \lstset{style=eclipse,language=java,#1}%
  \lstset{xleftmargin=\lst@numbersep}%
}{}

\newcommand{\includejavacodenostar}[2][]{%
  \addsourcefile{\@javasourcepath/#2}%
  \href{run:\@javasourcepath/#2}{%
    \hspace*{-\@itemdepth\leftmargin}%
    \vbox{%
      \lstinputlisting[%
        language=java,%
        style=eclipse,%
        xleftmargin=\lst@numbersep,%
        caption=\codefontfamily #2,%
        #1%
      ]{%
        \@javasourcepath/#2%
      }%
    }%
  }%
}%

\newcommand{\includejavacodestar}[2][]{%
  \hspace*{-\@itemdepth\leftmargin}%
  \vbox{%
    \lstinputlisting[%
      language=java,%
      style=eclipse,%
      xleftmargin=\lst@numbersep,%
      #1
    ]{%
      \@javasourcepath/#2%
    }%
  }%
}%


\newcommand{\includejavacode}{\@ifstar
  \includejavacodestar%
  \includejavacodenostar%
}

\newcommand{\includejavacodeinpackagenostar}[3][]{%
  \begingroup%
    \StrSubstitute{#2}{.}{/}[\@package]%
    \expandafter\addsourcefile\expandafter{\expandafter\@javasourcepath\expandafter/\@package/#3}%
    \href{run:\@javasourcepath/\@package/#3}{%
      \hspace*{-\@itemdepth\leftmargin}%
      \vbox{%
        \lstinputlisting[%
          language=java,%
          style=eclipse,%
          xleftmargin=\lst@numbersep,%
          caption=\codefontfamily #3,%
          #1
        ]{%
          \@javasourcepath/\@package/#3%
        }%
      }%
    }%
  \endgroup%
}%

\newcommand{\includejavacodeinpackagestar}[3][]{%
  \begingroup%
    \StrSubstitute{#2}{.}{/}[\@package]%
    \hspace*{-\@itemdepth\leftmargin}%
    \vbox{%
      \lstinputlisting[%
        language=java,%
        style=eclipse,%
        xleftmargin=\lst@numbersep,%
        #1
      ]{%
        \@javasourcepath/\@package/#3%
      }%
    }%
  \endgroup%
}%

\newcommand{\includejavacodeinpackage}{\@ifstar
  \includejavacodeinpackagestar%
  \includejavacodeinpackagenostar%
}


\newcount\@firstnumbercounterend%
\newcount\@firstnumbercounterrange%

\newenvironment{java*}[4]{%  #1 startlinenumber, #2 = linenumbercount #3 javapackage #4 javasource
  \begingroup%
    \newenvironment{#4}[1][]{% #1 globaloptions
      \begingroup%
        \offinterlineskip%
        \def\@globalargs{##1}%
        \expandafter\def\expandafter\range{\csname javarange#3#4\endcsname}%
        \csname javarelay1#3#4\endcsname%
    }{%
      \@endcmd%
      \endgroup%
      \ignorespacesafterend%
    }%
%
    \expandafter\newcommand\expandafter{\csname javarelay1#3#4\endcsname}[1][#1]{% ##1 = start-endlinenumber
      \ifthenelse{\equal{##1}{none}}{%
        \def\@startcmd{}%
      }{%
        \def\@startendlinenumber{linerange=#1-##1}%
        \edef\@startoptions{[\@startendlinenumber,caption=,belowskip=-0.5ex,\@globalargs]{#3}{#4}}%
        \def\@startcmd{\expandafter\includejavacodeinpackage\@startoptions\newline}%
      }%
      \csname javarelay2#3#4\endcsname%
    }%
%
    \expandafter\newcommand\expandafter{\csname javarelay2#3#4\endcsname}[1][#2]{%  ##1 = end-startlinenumber
      \ifthenelse{\equal{##1}{none}}{%
        \def\@endcmd{\expandafter\includejavacodeinpackage[print=false]{#3}{#4}}%
      }{%
        \@firstnumbercounterend=##1%
        \advance\@firstnumbercounterend by 1%
        \advance\@firstnumbercounterend by -#1%
        \edef\@endoptions{[linerange=##1-#2,firstnumber=\@firstnumbercounterend,\@globalargs]{#3}{#4}}%
        \def\@endcmd{\expandafter\includejavacodeinpackage\@endoptions\newline}%
      }%
      \@startcmd%
      \ignorespaces%
    }%
%
    \expandafter\newcommand\expandafter{\csname javarange#3#4\endcsname}[3][]{% ##1 = rangeoptions, ##2 = startlinenumber, ##3 = endlinenumber
      \@firstnumbercounterrange=##2%
      \advance\@firstnumbercounterrange by 1%
      \advance\@firstnumbercounterrange by -#1%
      \edef\@rangeoptions{[linerange=##2-##3,firstnumber=\@firstnumbercounterrange,belowskip=-0.5ex,caption=,\@globalargs,##1]{#3}{#4}}%
      \expandafter\includejavacodeinpackage\@rangeoptions\newline%
      \ignorespaces%
    }%
}{%
  \endgroup%
}%


%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%%
\newcounter{fhooe@cln@linenumbercount}%
\newcounter{fhooe@cln@emptylinenumbercount}%
\newcounter{fhooe@cln@savedendlinechar}%

\newread\fhooe@cln@file%

\newcommand{\fhooe@cln}[1] {%
  \setcounter{fhooe@cln@linenumbercount}{0}%
  \setcounter{fhooe@cln@emptylinenumbercount}{0}%
  \setcounter{fhooe@cln@savedendlinechar}{\endlinechar}%
  \endlinechar=-1%
  \openin\fhooe@cln@file=#1%
  \loop\unless\ifeof\fhooe@cln@file%
    \readline\fhooe@cln@file to \fhooe@fileline% Reads a line of the file into \fileline
    \ifdefempty{\fhooe@fileline}{%
      \stepcounter{fhooe@cln@emptylinenumbercount}%
    }{
      \addtocounter{fhooe@cln@linenumbercount}{\thefhooe@cln@emptylinenumbercount}%
      \setcounter{fhooe@cln@emptylinenumbercount}{0}%
      \stepcounter{fhooe@cln@linenumbercount}%
    }
  \repeat%
  \closein\fhooe@cln@file%
  \endlinechar=\thefhooe@cln@savedendlinechar%
}%

\newcommand{\mybegin}{}

\newenvironment{java}[3] {%
  \begingroup%
    \StrSubstitute{#2}{.}{/}[\@package]%
    \fhooe@cln{\@javasourcepath/\@package/#3}%
    \edef\@tmpbegin{\noexpand\begin{java*}{#1}{\thefhooe@cln@linenumbercount}{#2}{#3}}%
    \@tmpbegin%
}{%
    \end{java*}%
  \endgroup%
}%
