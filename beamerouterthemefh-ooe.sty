\def\inserttitlehead{\inserttitle}
\def\insertdegreehead{\insertdegree}
\def\insertshortdegreehead{\insertshortdegree}
\def\insertlecturenumbername{Kapitel}
\def\insertlonglecturenumberhead{\insertlecturenumbername{} \insertlecturenumber}
\def\insertlecturehead{\insertlecture}
\newcounter{framenumberinlecture}
\def\insertframenumberinlecture{%
  \setcounter{framenumberinlecture}{\value{framenumber}}%
  \addtocounter{framenumberinlecture}{-\value{lastframeoflastlecture}}%
  \arabic{framenumberinlecture}
}
