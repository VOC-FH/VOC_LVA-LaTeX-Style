\newcommand{\addplotfourier}[4][]{% #1=options to plot, #2omega, #3=sincoefficients #4=coscoefficients
  \xdef\fourierseries{0}%
  \expandafter\def\expandafter\koefizienten\expandafter{#3}%
  \foreach \a/\color [count=\k from 0] in \koefizienten {%
    \xdef\fourierseries{\fourierseries + \a * sin(\k*#2*x)}%
  }%
  \expandafter\def\expandafter\koefizienten\expandafter{#4}%
  \foreach \b/\color [count=\k from 0] in \koefizienten {%
    \xdef\fourierseries{\fourierseries + \b * cos(\k*#2*x)}%
  }%
  \addplot gnuplot [#1] {\fourierseries};%
  \global\let\fourierseries=\undefined%
}%

\newcommand{\addplotfouriersinspectrum}[3][]{%
  \expandafter\def\expandafter\koefizienten\expandafter{#3}%
  \foreach \a/\color [count=\k from 0, count=\i from 1] in \koefizienten {%
    \pgfmathparse{\a}
    \edef\temp{\noexpand\addplot[\color, #1] coordinates {(\k+#2, 0) (\k+#2, \pgfmathresult)};}%
    \temp
    \edef\temp{\noexpand\draw[draw=none, fill=\color, \color, #1]
      (\k+#2, \pgfmathresult) circle[anchor=center, #1] {};}%
    \temp
  }%
}%

\let\addplotfouriercosspectrum\addplotfouriersinspectrum%

