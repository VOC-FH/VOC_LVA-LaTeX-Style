\NeedsTeXFormat{LaTeX2e}
\ProvidesClass{fourieranalyses}[202/02/03 Plotting Fourier-Graphs using PGF and TikZ]

\newcommand{\addplotfouriersinbase}[3][]{%
  \def\fourierseries{0}%
  \foreach \a/\color [count=\k from 0] in {#3}{%
    \xdef\fourierseries{\fourierseries + \a * sin(\k*#2*x)}%
    \edef\temp{\noexpand\addplot gnuplot [#1, \color] {(\a) * sin(\k*#2*x)};}%
    \temp
  }%
  \let\fourierseries\undefined%
  \let\temp\undefined%
}%

