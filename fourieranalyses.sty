\newcommand{\addplotfourier}[4][]{% #1=omega, #2=sincoefficients #3=coscoefficients
  \def\fourierseries{0}%
  \foreach \a [count=\k from 0] in {#3}{%
    \xdef\fourierseries{\fourierseries + \a * sin(\k*#2*x)}%
  }%
  \foreach \a [count=\k from 0] in {#4}{%
    \xdef\fourierseries{\fourierseries + \a * cos(\k*#2*x)}%
  }%
  \edef\temp{\noexpand\addplot gnuplot [#1] {\fourierseries};}%
  \temp%
  \let\fourierseries\undefined%
  \let\temp\undefined%
}%

\newcommand{\addplotfouriersinspectrum}[3][]{%
  \foreach \a/\color [count=\k from 0] in {#3}{%
    \pgfmathparse{\a}
    \edef\temp{\noexpand\draw[\color, #1] (\k, 0) -- (\k, \pgfmathresult);}%
    \temp
    \edef\temp{\noexpand\draw[draw=none, fill=\color, \color, #1]
      (\k, \pgfmathresult) circle[anchor=center, #1] {};}%
    \temp
  }%
}%

\let\addplotfouriercosspectrum\addplotfouriersinspectrum%

\newcommand{\addplotfourierspectrum}[4][]{%
