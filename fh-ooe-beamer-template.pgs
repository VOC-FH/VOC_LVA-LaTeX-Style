\usetikzlibrary{positioning,shapes.multipart,shadows,calc,arrows,fit,trees}
\usepackage{pgfkeys}

\newlength{\codebaselineskip} 
\tiny
\setlength{\codebaselineskip}{\baselineskip}
\normalsize
\usepackage{pgfpages}
\pgfpagesuselayout{8 on 1}[a4paper,portrait,border shrink=5mm]

\newdimen\height
\newdimen\width
\newsavebox{\mybox}

\def\mymeasure{fdf}

\begin{document}[without titlepage]%
  \begin{frame}%
    \sbox{\mybox}{<>}%
    \settototalheight\height{\usebox{\mybox}}%
    \settowidth\width{\usebox{\mybox}}%
    \centering\fbox{\usebox{\mybox}}\\%
    \scriptsize width = \the\width, height = \the\height%
  \end{frame}%
\end{document}
