\define@key{svgoptions}{width}{\def\svgwidth{#1}}
\define@key{svgoptions}{scale}{\def\svgscale{#1}}
\define@key{svgoptions}{rename}{\def\pdfrename{_#1}}
\define@key{svgoptions}{rerender}{%
  \def\rerender{#1}%
  \def\rTrue{true}%
  \def\rFalse{false}%
  \ifx\rTrue\rerender%
  \else%
    \ifx\rFalse\rerender%
    \else%
      \PackageWarning{Warning: Wrong value #1 for option rerender! Using global rerendering setting! Usage: rerender={true, false}}%
    \fi%
  \fi%
}%
\define@key{svgoptions}{inkscape}{\def\inkscapeoptions{#1}}
\define@key{svgoptions}{export}{%
  \def\option{#1}
  \def\drawing{drawing}
  \def\page{page}
  \ifx\drawing\option%
    \def\inkscapeexport{--export-area-drawing}%
  \else%
    \ifx\page\option%
      \def\inkscapeexport{--export-area-page}%
    \else%
      \PackageWarning{Warning: Wrong value #1 for option export! Using ''drawing''! Usage: export={page, drawing}}%
    \fi%
  \fi%
}%

\def\inkscapeoptions#1{\def\ink@skapeoptions{#1}}
\def\ink@skapeoptions{}

\newif\if@Rerender%
\@Rerenderfalse
\def\svgenablererender{\@Rerendertrue}
\def\svgdisablererender{\@Rerenderfalse}

\newcommand{\executeiffilenewer}[3]{%
  \ifnum\pdfstrcmp{\pdffilemoddate{#1}}{\pdffilemoddate{#2}}>0%
    \immediate\write18{#3}%
  \else%
    \if@Rerender%
      \ifx\rerender\undefined%
        \immediate\write18{#3}%
      \else%
        \ifx\rerender\rTrue%
          \immediate\write18{#3}%
        \fi%
      \fi%
    \else%
      \ifx\rerender\undefined%
      \else%
        \ifx\rerender\rTrue%
          \immediate\write18{#3}%
        \fi%
      \fi%
    \fi%
  \fi%
}%

\newcommand{\forAllInputpaths}[2][\path]{\@for#1:=\@inputpaths\do{#2}}%

\newcommand{\ink@include}[3][]{%
  \newif\ifBreak%
  \Breakfalse%
  \def\inkscapeoptions{}%
  \def\inkscapeexport{--export-area-drawing}%
  \def\pdfrename{}%
  \setkeys{svgoptions}{#1}%
  \ifx\Ginput@path\@undefined%
    \let\@inputpaths\input@path%
  \else%
    \let\@inputpaths\Ginput@path%
  \fi%
  \ifx\@inputpaths\@undefined%
    \def\@inputpaths{}%
  \fi
  \IfFileExists{#2.#3} {%
    \def\inputpath{.}%
  }{%
    \forAllInputpaths[\path] {%
      \ifBreak%
      \else%
        \IfFileExists{\path/#2.#3} {%
          \edef\inputpath{\path}%
          \Breaktrue%
        }{}%
      \fi%
    }%
    \Breakfalse%
  }%
  \ifx\inputpath\@undefined%
    \@warning{Warning: File #2.#3 not found in search path}%
  \else%
    \executeiffilenewer{\inputpath/#2.#3}
      {\inputpath/#2_#3\pdfrename.pdf}%
      {inkscape -z --file=\inputpath/#2.#3\space%
        --export-pdf=\inputpath/#2_#3\pdfrename.pdf\space%
        --export-latex \inkscapeexport\space%
        \ink@skapeoptions\space\inkscapeoptions%
      }%
    \subimport{\inputpath/}{#2_#3\pdfrename.pdf_tex}%
  \fi%
}%

\newcommand{\fhincludesvg}[2][]{%
  \ink@include[#1]{#2}{svg}%
}%

\newcommand{\fhincludeeps}[2][]{%
  \ink@include[#1]{#2}{eps}%
}%

\newcommand{\fhincludepdf}[2][]{%
  \ink@include[#1]{#2}{pdf}%
}%
