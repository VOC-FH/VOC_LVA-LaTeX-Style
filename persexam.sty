\def\placenumberlist{
    \pagestyle{empty}
    \def\rightheader{Platznummern}
    \dtlsort{Name}{studentsdb}{\dtlcompare}
    \clearpage
    \setcounter{page}{1}
    \begin{longtable}{C{3cm}L{4cm}L{4cm}R{1cm}}
        \multicolumn{4}{c}{\Huge \textbf{\lvabezeichnung{}}}\\
        \multicolumn{4}{c}{\semester{} -- \termin{}\raise -1.5em\hbox{}}\\
        \caption*{\Huge \textbf{Platznummern (PN)}}\\
        \textbf{Kennzeichen} & \textbf{Name} & \textbf{Vorname} & \textbf{PN}\\\hline
        \endfirsthead
        \multicolumn{4}{c}{\Huge \textbf{\lvabezeichnung{}}}\\
        \multicolumn{4}{c}{\semester{} -- \termin{}\raise -1.5em\hbox{}}\\
        \caption*{\Huge \textbf{Platznummern (PN)}}\\
        \textbf{Kennzeichen} & \textbf{Name} & \textbf{Vorname} & \textbf{PN}\\\hline
        \endhead
        \DTLforeach*{studentsdb}{%,
            \Kennzeichen=Kennzeichen,%
            \Name=Name,%
            \Vorname=Vorname,%
            \Platznummer=Platznummer%
        }{%
            \ifthenelse{\equal{\Name}{Dow}}{}{%
                \Kennzeichen & \Name & \Vorname & \Platznummer \\%
            }%
        }
    \end{longtable}
    \csname protected@write\endcsname\splitfile{}{pdftk ../\jobname.pdf cat
        \theabspage-\the\numexpr\value{abspage}+\value{page}-1\relax\space output
        \jobname_seatnumber.pdf verbose}
    \addtocounter{abspage}{\value{page}}%
    \csname protected@write\endcsname\printfile{}{echo \jobname_seatnumber.pdf; 
        lpr -P \dollar PRINTER \dollar PRINTOPTION -o RepeatJob=4 \jobname_seatnumber.pdf}
    \csname protected@write\endcsname\removefile{}{rm \jobname_seatnumber.pdf 2> /dev/null}%
}

\def\@lectureroomlist#1{%
    \dtlsort{Platznummer}{studentsdb}{\dtlcompare}
    \setcounter{@leftstudents}{\the\numexpr\numberofstudents-\csname the@currentstudent\endcsname-\thejohndows\relax}%
    \ifnum\csname the@leftstudents\endcsname<\csname thelr#1@sizec\endcsname%
        \setcounter{@hsmax}{\the\numexpr\csname thelr#1@fromc\endcsname + \csname the@leftstudents\endcsname - 1\relax}%
    \else%
        \setcounter{@hsmax}{\the\numexpr\csname thelr#1@fromc\endcsname + \csname thelr#1@sizec\endcsname - 1\relax}%
    \fi%
    \ifnum\csname the@hsmax\endcsname<\csname thelr#1@fromc\endcsname\else%
        \clearpage%
        \setcounter{page}{1}%
        \begin{longtable}{R{1cm}C{3cm}L{4cm}L{4cm}}%
            \multicolumn{4}{c}{\Huge \textbf{\lvabezeichnung{}}}\\%
            \multicolumn{4}{c}{\semester{} -- \termin{}\raise -1.5em\hbox{}}\\%
            \multicolumn{4}{c}{\fontsize{40pt}{40pt}\selectfont\textbf{PN \arabic{lr#1@fromc}{} -- \arabic{@hsmax}}\raise -0.5em\hbox{}}\\%
            \caption*{\Huge \textbf{\csname lr#1@name\endcsname}}\\%
            \textbf{PN} & \textbf{Kennzeichen} & \textbf{Name} & \textbf{Vorname}\\\hline%
            \endfirsthead%
            \multicolumn{4}{c}{\Huge \textbf{\lvabezeichnung{}}}\\%
            \multicolumn{4}{c}{\semester{} -- \termin{}\raise -1.5em\hbox{}}\\%
            \multicolumn{4}{c}{\fontsize{40pt}{40pt}\selectfont\textbf{PN \arabic{lr#1@fromc}{} -- \arabic{@hsmax}}\raise -0.5em\hbox{}}\\%
            \caption*{\Huge \textbf{\csname lr#1@name\endcsname}}\\%
            \textbf{PN} & \textbf{Kennzeichen} & \textbf{Name} & \textbf{Vorname}\\\hline%
            \endhead%
            \DTLforeach*[\DTLisclosedbetween{\Platznummer}{\value{lr#1@fromc}}{\value{@hsmax}}]{studentsdb}{%
                \Kennzeichen=Kennzeichen,%
                \Name=Name,%
                \Vorname=Vorname,%
                \Platznummer=Platznummer%
            }{%
                \ifthenelse{\equal{\Name}{Dow}}{}{%
                    \Platznummer & \Kennzeichen & \Name & \Vorname \\%
                    \stepcounter{@currentstudent}%
                }%
            }%
        \end{longtable}%
        
        \csname protected@write\endcsname\splitfile{}{pdftk ../\jobname.pdf cat
            \theabspage-\the\numexpr\value{abspage}+\value{page}-1\relax\space output
            \jobname_lr_#1{}.pdf verbose}
        \addtocounter{abspage}{\value{page}}%

        \csname protected@write\endcsname\printfile{}{echo \jobname_lr_#1{}.pdf; 
            lpr -P \dollar PRINTER \dollar PRINTOPTION -o RepeatJob=2 \jobname_lr_#1{}.pdf}

        \csname protected@write\endcsname\removefile{}{rm \jobname_lr_#1{}.pdf 2> /dev/null}%
    \fi%
    \clearpage% To write the final commands to the script-files also
}

\gdef\lectureroomlists{\placenumberlist}%
