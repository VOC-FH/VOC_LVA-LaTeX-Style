        \checkoddpage
        \ifoddpage
            \phantom{Odd detected, do nothing because this}
            \newline
            \phantom{is the first page of an empty sheet}
            \newline
        \else
            \phantom{Even detected, do a newpage to ship}
            \newline
            \phantom{out the current (not empty) sheet}
            \newpage
        \fi
        \phantom{First empty Page on odd page}
        \newpage
