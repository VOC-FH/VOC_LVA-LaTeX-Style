\def\lectureroom#1#2#3{%
%     \gdef\lectureroomlists{\placenumberlist}%
%     \newcounter{@currentplaces}%
%     \newcounter{@hsmax}%
%     \newcounter{@currentstudent}%
%     \newcounter{@leftstudents}%
    \newcounter{lr#1@fromc}%
    \setcounter{lr#1@fromc}{\csname the@currentplaces\endcsname}%
    \stepcounter{lr#1@fromc}%
    \newcounter{lr#1@sizec}%
    \setcounter{lr#1@sizec}{#3}%
    \expandafter\def\csname lr#1@name\endcsname{#2}%
    \addtocounter{@currentplaces}{#3}%
    \expandafter\def\expandafter\lectureroomlists\expandafter{\lectureroomlists{} \@lectureroomlist{#1}}%
}%

\def\addlectureroom#1#2#3{%
    \newcounter{lr#1@fromc}%
    \setcounter{lr#1@fromc}{\csname the@currentplaces\endcsname}%
    \stepcounter{lr#1@fromc}%
    \newcounter{lr#1@sizec}%
    \setcounter{lr#1@sizec}{#3}%
    \expandafter\def\csname lr#1@name\endcsname{#2}%
    \addtocounter{@currentplaces}{#3}%
    \expandafter\def\expandafter\lectureroomlists\expandafter{\lectureroomlists{} \@lectureroomlist{#1}}%
}%

