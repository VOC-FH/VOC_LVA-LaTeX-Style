\NewEnviron{foreachstudent}[1][\jobname]{
    \def\dollar{$}
    \DTLsetseparator{,}
    \IfFileExists{#1.csv}{%
        \filemodcmp[2]{\jobname/\jobname_prepared.csv}{#1.csv}{%
            \DTLloadrawdb[keys={Kennzeichen,Name,Vorname,Rand,Platznummer}]{studentsdb}{\jobname/#1_prepared.csv}%
        }{%
            \DTLloadrawdb[noheader, keys={Kennzeichen,Name,Vorname}]{studentsdb}{#1.csv}%
            \DTLforeach{studentsdb}{%
            }{%
                \rand%
                \DTLappendtorow{Rand}{\therand}%
            }%
            \DTLnewrow{studentsdb}%
            \DTLnewdbentry{studentsdb}{Kennzeichen}{08/1/5471/101}%
            \DTLnewdbentry{studentsdb}{Name}{Dow}%
            \DTLnewdbentry{studentsdb}{Vorname}{Jane}%
            \DTLnewdbentry{studentsdb}{Rand}{100002}%
            \DTLnewrow{studentsdb}%
            \DTLnewdbentry{studentsdb}{Kennzeichen}{08/1/5471/102}%
            \DTLnewdbentry{studentsdb}{Name}{Dow}%
            \DTLnewdbentry{studentsdb}{Vorname}{John}%
            \DTLnewdbentry{studentsdb}{Rand}{100001}%
            \dtlsort{Rand=descending}{studentsdb}{\dtlcompare}%
            \DTLforeach{studentsdb}{%
            }{%
                \DTLappendtorow{Platznummer}{\DTLcurrentindex}%
                \DTLremoveentryfromrow{Rand}%
            }%
            \DTLsavedb{studentsdb}{\jobname/#1_prepared.csv}%
        }%
    }{%
        \DTLgnewdb{studentsdb}%
        \DTLnewrow{studentsdb}%
        \DTLnewdbentry{studentsdb}{Kennzeichen}{0123456789}%
        \DTLnewdbentry{studentsdb}{Name}{Christian}%
        \DTLnewdbentry{studentsdb}{Vorname}{Volker}%
        \DTLnewdbentry{studentsdb}{Rand}{0}%
        \DTLnewdbentry{studentsdb}{Platznummer}{1}%
    }%
    \edef\numberofstudents{\DTLrowcount{studentsdb}}%
    \ifthenelse{\DTLisnumerical{\totalpoints}}{%
        \DTLdiv{\numpointsperexam}{\totalpoints}{\numberofstudents}%
        \DTLdiv{\fiftypercentpoints}{\numpointsperexam}{2}%
        \DTLdiv{\gap}{\fiftypercentpoints}{4}%
        \DTLsub{\lowerpoints}{\numpointsperexam}{\gap}\DTLround{\einslower}{\lowerpoints}{1}
        \DTLsub{\lowerpoints}{\lowerpoints}{\gap}\DTLround{\zweilower}{\lowerpoints}{1}
        \DTLsub{\lowerpoints}{\lowerpoints}{\gap}\DTLround{\dreilower}{\lowerpoints}{1}
        \DTLsub{\lowerpoints}{\lowerpoints}{\gap}\DTLround{\vierlower}{\lowerpoints}{1}
    }{}%
}[
    \newcounter{johndows}
    \DTLforeach{studentsdb}{%,
        \Kennzeichen=Kennzeichen,%
        \Name=Name,%
        \Vorname=Vorname,%
        \Platznummer=Platznummer%
    }{%
        \xdef\rightheader{\Vorname{} \Name{}}%
        \ifthenelse{\equal{\Name}{Dow}}{%
            \stepcounter{johndows}%
        }{}%
        \setcounter{page}{1}
        \maketitle%
        \begin{textblock*}{100mm}(10mm,10mm)%
            \fontsize{80pt}{80pt}\selectfont \textbf{PN \Platznummer}%
        \end{textblock*}%
        {\Huge%
            \begin{center}
                \textbf{\Vorname{} \Name{}}\\
                \textbf{\Kennzeichen}\\
                \vspace{\baselineskip}
                \underline{\phantom{HHHHHHHHHHHHHHHH}}\\
                \small Unterschrift
            \end{center}%
        }%
        \vspace{\baselineskip}%
        {%
            \Large Bearbeitungszeit: \textbf {90 Minuten}\hfill
            Punktemaximum: \textbf{\numpointsperexam{} Punkte}%
        }
        \vspace{0.5\baselineskip}%
        \ifthenelse{\DTLisnumerical{\totalpoints}}{%
            \begin{center}
                \begin{tabular}{rr|l}
                    \multicolumn{2}{c}{\textbf{Punkte $p$}} & \textbf{Note} \\
                    \hline
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[35pt]{$< p \le$}}}{
                        \num{\einslower}
                    } & 
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[30pt]{\centering \ldots}}}{
                        \num{\numpointsperexam}
                    } & 
                        Sehr gut\\
                        
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[35pt]{$< p \le$}}}{
                        \num{\zweilower}
                    } & 
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[30pt]{\centering \ldots}}}{
                        \num{\einslower}
                    } & 
                        Gut\\
                        
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[35pt]{$< p \le$}}}{
                        \num{\dreilower}
                    } & 
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[30pt]{\centering \ldots}}}{
                        \num{\zweilower}
                    } & 
                        Befriedigend\\
                        
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[35pt]{$< p \le$}}}{
                        \num{\vierlower}
                    } & 
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[30pt]{\centering \ldots}}}{
                        \num{\dreilower}
                    } & 
                        Gen\"ugend\\
                        
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[35pt]{$\le p \le$}}}{
                        \num{0}
                    } & 
                    \multicolumn{1}{r@{\hspace*{\tabcolsep}\makebox[30pt]{\centering \ldots}}}{
                        \num{\vierlower}
                    } & 
                        Nicht Gen\"ugend\\
                    \hline
                \end{tabular}
            \end{center}
        }{}
        \vfill
        {\Large Hinweise zur Ausf\"uhrung}
        \hintss
        \thispagestyle{empty}
        \newpage
%%%%%%%%%%%%%%%%%%%
        \BODY
%%%%%%%%%%%%%%%%%%%
        \newpage
