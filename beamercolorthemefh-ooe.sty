\ProvidesPackage{beamercolorthemefh-ooe}

\mode<presentation>

\definecolor{fh-ooe-red}{HTML}{A40017}
\definecolor{alert-blue}{HTML}{1700A4}

\setbeamercolor{section in toc}{fg=black,bg=white}
\setbeamercolor{alerted text}{fg=alert-blue}
\setbeamercolor*{palette primary}{fg=fh-ooe-red!60!black,bg=gray!30!white}
\setbeamercolor*{palette secondary}{fg=fh-ooe-red!70!black,bg=gray!15!white}
\setbeamercolor*{palette tertiary}{bg=fh-ooe-red!80!black,fg=gray!10!white}
\setbeamercolor*{palette quaternary}{fg=fh-ooe-red,bg=gray!5!white}

\setbeamercolor*{sidebar}{fg=fh-ooe-red,bg=gray!15!white}

\setbeamercolor*{palette sidebar primary}{fg=fh-ooe-red!10!black}
\setbeamercolor*{palette sidebar secondary}{fg=white}
\setbeamercolor*{palette sidebar tertiary}{fg=fh-ooe-red!50!black}
\setbeamercolor*{palette sidebar quaternary}{fg=gray!10!white}

\setbeamercolor{titlelike}{parent=pallette primary,fg=fh-ooe-red}
\setbeamercolor{frametitle}{bg=gray!10!white}
\setbeamercolor{frametitle right}{bg=gray!60!white}

\setbeamercolor*{separation line}{}
\setbeamercolor*{fine separation line}{}

\setbeamercolor{structure}{fg=fh-ooe-red}

\mode<all>
