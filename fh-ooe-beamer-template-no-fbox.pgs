\documentclass[utf8x]{fh-ooe}
\usepackage[orientation=landscape,size=custom,width=17.06,height=9.6,scale=0.4,debug]{beamerposter}

\pgfdeclarelayer{background}
\pgfdeclarelayer{foreground}
\pgfsetlayers{background,main,foreground}

\setbeamersize{
    text margin left=10mm,
    text margin right=10mm,
    sidebar width left  = 0mm,
    sidebar width right = 0mm
}

\usepackage{pgfkeys}
\usepackage{pgfplots}
\usepackage{pgfplotstable}
\usepackage{filecontents}
\usepackage{varwidth}
\usepackage[euler]{textgreek}

\pgfkeys{/pgf/number format/.cd,1000 sep={\,}}

\usepgfplotslibrary{dateplot}

\usetikzlibrary{positioning,shapes.multipart,shadows,calc,arrows,fit,trees}
\usetikzlibrary{arrows.meta, quotes}
\usetikzlibrary{intersections, tikzmark}

\pgfplotsset{
  every axis x label/.style={
    at={
      (current axis.right of origin)
    },
    anchor=north,
    align=center
  },
  every axis y label/.style={
    at={
      (current axis.above origin)
    },
    anchor=south,
    align=center,
    inner sep=0
  },
  xtick align=center, 
  ytick align=center,
  tick label style={font=\scriptsize},
  axis x line*=bottom,
  axis y line*=left,  
  x axis line style={-latex},
  y axis line style={-latex},
  ylabel style={font=\footnotesize},
  xlabel style={font=\footnotesize}
}

\usefonttheme[onlymath]{serif}

\newdimen\height
\newdimen\width
\newsavebox{\mybox}

\makeatletter
\long\def\beamer@part[#1]#2{}
\long\def\beamer@section[#1]#2{}%
\def\beamer@subsection[#1]#2{}%
\def\beamer@subsubsection[#1]#2{}%
\makeatother

\begin{document}[without titlepage]%
%  \begin{frame}{Frame Title}%
    <>
%  \end{frame}%
\end{document}
