\newdimen\height
\newdimen\width
\newsavebox{\mybox}

\def\mymeasure{fdf}
\pgfdeclarelayer{foreground}
\pgfsetlayers{background,main,foreground}

\begin{document}[without titlepage]%
  \begin{frame}%
    \sbox{\mybox}{<>}%
    \settototalheight\height{\usebox{\mybox}}%
    \settowidth\width{\usebox{\mybox}}%
    \centering\fbox{\usebox{\mybox}}\\%
    \scriptsize width = \the\width, height = \the\height%
  \end{frame}%
\end{document}
