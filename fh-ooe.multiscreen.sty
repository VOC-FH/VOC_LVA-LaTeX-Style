\ProvidesPackage{fh-ooe.multiscreen}[2012/03/07 ver 0.01]

\mode<trans>{%
  \RequirePackage{pgfpages}

  \def\fhooe@printlayout{fhooe resize to}
  \def\fhooe@printlayoutoptions{[a4paper,border shrink=5mm]}

  \pgfpagesdeclarelayout{fhooe resize to}
  {
    \def\pgfpageoptionborder{0pt}
  }
  {
    \pgfpagesphysicalpageoptions
    {%
      logical pages=1,%
      physical height=\pgfpageoptionheight,%
      physical width=\pgfpageoptionwidth%
    }
    \pgfpageslogicalpageoptions{1}
    {%
      resized width=\pgfphysicalwidth,%
      resized height=\pgfphysicalheight,%
      border shrink=\pgfpageoptionborder,%
      center=\pgfpoint{.5\pgfphysicalwidth}{.73\pgfphysicalheight}%
    }%
  }

  \expandafter\pgfpagesuselayout\expandafter\fhooe@printlayout\fhooe@printlayoutoptions
}

\mode<handout>{%
  \RequirePackage{pgfpages}
  
  \def\fhooe@handoutlayout{4 on 1}
  \def\fhooe@handoutlayoutoptions{[a4paper,landscape,border shrink=5mm]}

  \expandafter\pgfpagesuselayout\expandafter\fhooe@handoutlayout\fhooe@handoutlayoutoptions

  \def\fhooe@handoutoptions{\setbeamercolor{background canvas}{bg=black!1}}
  \fhooe@handoutoptions
}

\mode<all>

\ifx\fhooe@twoscreens\@empty
  \relax
\else
  \RequirePackage{pgfpages}
  \define@key{pgfpages@main}{backgroundcolor}{\gdef\pgfphysicalbackgroundcolor{#1}}
 
  \def\fhooe@inittwoscreens{%
    \beamer@twoscreenstexttrue%
    \nofiles%
    
    \def\fhooe@buildshipoutbox{%
      \setbox\pgfpages@shipoutbox=\vbox{%
        \set@typeset@protect%
        \pgfsys@beginpicture%
        \ifdefined\pgfphysicalbackgroundcolor%
          \color{\pgfphysicalbackgroundcolor}%
          \pgfpathrectangle{\pgfpointorigin}{\pgfpoint{\pgfphysicalwidth}{\pgfphysicalwidth}}%
          \pgfusepath{fill}%
        \fi%
        \pgfsys@endpicture%
        \box\pgfpages@shipoutbox%
      }%
    }%
    
    \def\fhooe@shipoutshipoutbox{%
      \fhooe@buildshipoutbox%
      \fhooe@pgfpages@shipoutshipoutbox%
    }%
    
    \let\fhooe@pgfpages@shipoutshipoutbox=\pgfpages@shipoutshipoutbox%
    \let\pgfpages@shipoutshipoutbox=\fhooe@shipoutshipoutbox%

    \AtEndDocument{%
      \beamer@inlecturetrue%
      \begin{frame}
        \begin{center}\fhooe@HUGE ENDE\end{center}%
      \end{frame}%
      \setbeamercolor{background canvas}{bg=black}%
      \begin{frame}[plain]%
      \end{frame}%
      \pgfshipoutphysicalpage%
    }%
  }%

